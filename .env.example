# Copy to .env.local (git-ignored) and adjust for your environment.

# Comma-separated list of extra hostnames allowed to reach the Vite dev
# server. Useful when accessing the dev server through a reverse proxy or
# tunnel (Vite blocks unknown Host headers by default).
# Example:
# VITE_ALLOWED_HOSTS=dev.example.com,tunnel.example.dev
VITE_ALLOWED_HOSTS=
